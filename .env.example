######## General ########
NAMESPACE=huma


######## RustFS ########
RUSTFS_STANDALONE_ENABLED=true
RUSTFS_DISTRIBUTED_ENABLED=false
RUSTFS_STORAGE_CLASS=standard
RUSTFS_DATA_STORAGE_SIZE=8Gi
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=admin
RUSTFS_S3_ENDPOINT=rustfs-svc.huma.svc.cluster.local:9000


######## Loki ########
LOKI_AUTH_ENABLED=false
LOKI_REPLICATION_FACTOR=1
LOKI_RETENTION_PERIOD=672h
LOKI_BUCKET_CHUNKS=huma-loki-chunks
LOKI_BUCKET_RULER=huma-loki-ruler
LOKI_BUCKET_ADMIN=huma-loki-admin
LOKI_S3_REGION=us-east-1
LOKI_S3_SIGNATURE_VERSION=v4
LOKI_S3_FORCE_PATH_STYLE=true
LOKI_S3_INSECURE=true
LOKI_PERSISTENCE_SIZE=8Gi
LOKI_GATEWAY_ENABLED=true


######## Prometheus ########
PROMETHEUS_ALERTMANAGER_ENABLED=false
PROMETHEUS_KUBE_STATE_METRICS_ENABLED=false
PROMETHEUS_PUSHGATEWAY_ENABLED=false


######## Grafana ########
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PERSISTENCE_SIZE=8Gi
GRAFANA_SERVICE_TYPE=LoadBalancer
GRAFANA_SERVICE_PORT=3000
GRAFANA_PROMETHEUS_URL=http://prometheus-server.huma.svc.cluster.local
GRAFANA_LOKI_URL=http://loki-gateway.huma.svc.cluster.local


######## Alloy ########
ALLOY_CONTROLLER_TYPE=daemonset
ALLOY_LOKI_PUSH_URL=http://loki-gateway.huma.svc.cluster.local/loki/api/v1/push


######## Postgres ########
HUMA_DB_INSTANCES=1
HUMA_DB_IMAGE_VERSION=18.3
HUMA_DB_STORAGE_SIZE=8Gi
HUMA_DB_DATABASE_NAME=huma_db
HUMA_DB_DATABASE_USER=huma_db_user
HUMA_DB_DATABASE_PASSWORD_SECRET_NAME=huma-db-secret
HUMA_DB_DATABASE_PASSWORD=supersecret
HUMA_DB_RW_DATABASE_URL=postgres://huma_db_user:supersecret@db-rw.huma.svc.cluster.local:5432/huma_db
HUMA_DB_RO_DATABASE_URL=postgres://huma_db_user:supersecret@db-ro.huma.svc.cluster.local:5432/huma_db
HUMA_DB_R_DATABASE_URL=postgres://huma_db_user:supersecret@db-r.huma.svc.cluster.local:5432/huma_db


######## NATS ########
HUMA_NATS_JETSTREAM_ENABLED=true
HUMA_NATS_JETSTREAM_FILESTORE_ENABLED=true
HUMA_NATS_JETSTREAM_PVC_ENABLED=true
HUMA_NATS_JETSTREAM_STORAGE_SIZE=8Gi
HUMA_NATS_CONNECT_URL=nats://nats.huma.svc.cluster.local:4222


######## API ########
API_DEPLOYMENT_REPLICAS=1
API_DEPLOYMENT_ARG=api
API_DEPLOYMENT_CONTAINER_NAME=api
API_DEPLOYMENT_CONTAINER_PORT=8000
API_SERVICE_PORT=8000
HUMA_JWT_SECRET=supersecret


######## Workflow Evaluator ########
WORKFLOW_EVALUATOR_DEPLOYMENT_REPLICAS=1
WORKFLOW_EVALUATOR_DEPLOYMENT_ARG=workflow-evaluator
WORKFLOW_EVALUATOR_DEPLOYMENT_CONTAINER_NAME=workflow-evaluator
WORKFLOW_EVALUATOR_DEPLOYMENT_CONTAINER_PORT=7000
WORKFLOW_EVALUATOR_SERVICE_TYPE=ClusterIP
WORKFLOW_EVALUATOR_SERVICE_PORT=7000


######## Workflow Executor ########
WORKFLOW_EXECUTOR_DEPLOYMENT_REPLICAS=1
WORKFLOW_EXECUTOR_DEPLOYMENT_ARG=workflow-executor
WORKFLOW_EXECUTOR_DEPLOYMENT_CONTAINER_NAME=workflow-executor
WORKFLOW_EXECUTOR_DEPLOYMENT_CONTAINER_PORT=7001
WORKFLOW_EXECUTOR_SERVICE_PORT=ClusterIP
WORKFLOW_EXECUTOR_SERVICE_PORT=7001
WORKFLOW_EXECUTOR_WORKER_COUNT=4


######## Pipeline Executor ########
PIPELINE_EXECUTOR_DEPLOYMENT_REPLICAS=1
PIPELINE_EXECUTOR_DEPLOYMENT_ARG=pipeline-executor
PIPELINE_EXECUTOR_DEPLOYMENT_CONTAINER_NAME=pipeline-executor
PIPELINE_EXECUTOR_DEPLOYMENT_CONTAINER_PORT=7002
PIPELINE_EXECUTOR_SERVICE_TYPE=ClusterIP
PIPELINE_EXECUTOR_SERVICE_PORT=7002
PIPELINE_EXECUTOR_WORKER_COUNT=4
